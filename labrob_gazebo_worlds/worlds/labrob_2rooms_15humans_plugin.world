    <!-- Actors controlled via EnhancedActorPlugin -->
    <!-- Lower (larger) room: 10 humans -->
    <actor name="actor_0">
      <pose>-3.2 -0.4 0 0 0 0</pose>
      <skin>
        <filename>walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <plugin name="actor_0_traj" filename="libEnhancedActorPlugin.so">
        <behavior>walking_pair</behavior>
        <partner>actor_1</partner>
        <formation_distance>0.7</formation_distance>
        <min_waypoint_separation>8.0</min_waypoint_separation>
        <velocity>0.5</velocity>
        <min_x>-4.5</min_x>
        <max_x>4.5</max_x>
        <min_y>-4.5</min_y>
        <max_y>4.5</max_y>
        <num_waypoints>2</num_waypoints>
      </plugin>
    </actor>

